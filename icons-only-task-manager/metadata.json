        "Icon": "preferences-system-windows",
        "Id": "org.kde.plasma.taskmanager",
        "License": "GPL-2.0+",
        "Name": "Task Manager",
        "ServiceTypes": [
            "Plasma/Applet"
        ],
        "Version": "1.0"
    },
    "X-Plasma-API": "declarativeappletscript",
