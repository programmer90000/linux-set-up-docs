[core]
    pager = delta
    editor = nvim
    autocrlf = input
    eol = lf
    safecrlf = warn
    quotePath = false
    whitespace = trailing-space,space-before-tab,indent-with-non-tab,cr-at-eol

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled=true

[help]
    autoCorrect = 0
    format = man

[user]
    useConfigOnly = true

[status]
    relativePaths = false
    short = false
    aheadBehind = true
    displayCommentPrefix = false
    showStash = true
    showUntrackedFiles = normal
    branch = true
