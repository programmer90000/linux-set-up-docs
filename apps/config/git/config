[core]
    pager = delta
    editor = nvim
    autocrlf = input
    eol = lf
    safecrlf = warn
    quotePath = false
    whitespace = trailing-space,space-before-tab,indent-with-non-tab,cr-at-eol

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true

[merge]
    conflictStyle = zdiff3

[rerere]
    enabled=true
