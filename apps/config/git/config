[core]
    pager = delta
    editor = nvim
    autocrlf = input
    eol = lf
    safecrlf = warn
    quotePath = false
    whitespace = trailing-space,space-before-tab,indent-with-non-tab,cr-at-eol

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    dark = true

[merge]
    tool = nvimdiff
    conflictStyle = zdiff3
    renormalize = false
    defaultToUpstream = false
    ff = only
    autoStash = false
    verifySignatures = true
    log = true
    branchdesc = true
    renames = copy
    stat = true
    verbosity = 4

[mergetool]
    keepBackup = false
    keepTemporaries = false
    writeToTemp = false
    hideResolved = false
    prompt = false

[mergetool "nvimdiff"]
    layout = "BASE / (LOCAL, MERGED, REMOTE)"

[rerere]
    enabled=true

[help]
    autoCorrect = 0
    format = man

[user]
    useConfigOnly = true

[status]
    relativePaths = false
    short = false
    aheadBehind = true
    displayCommentPrefix = false
    showStash = true
    showUntrackedFiles = normal
    branch = true

[i18n]
    commitEncoding = UTF-8
    logOutputEncoding = UTF-8

[init]
    defaultBranch = main

[color]
    ui = auto
    advice = always

[column]
    ui = auto dense

[sequence]
    editor = nvim

[blame]
    showEmail = true
    blankBoundary = false
    date = default

[log]
    date = default

[tag]
    sort = version:refname

[branch]
    sort = refname
    sort = version:refname
    sort = -committerdate

[pull]
    ff = only
    rebase = interactive

[push]
    default = simple
    followTags = true
    gpgSign = false

[commit]
    status = true

[stash]
    showIncludeUntracked = true
    showPatch = false
    showStat = true

[diff]
    tool = nvimdiff
    autoRefreshIndex = true
    algorithm = histogram
    context = 3
    interHunkContext = 0
    indentHeuristic = 0
    suppressBlankEmpty = false
    wordRegex = "."
    mnemonicPrefix = true
    noPrefix = false
    srcPrefix = previous
    dstPrefix = new
    relative = false
    submodule = diff
    ignoreSubmodules = untracked
    colorMoved = zebra
    colorMovedWS = ignore-all-space
    wsErrorHighlight = all
    dirstat = files,cumulative,0

[difftool]
    trustExitCode = true
    prompt = false
    guiDefault = false

[grep]
    lineNumber = true
    column = true
    patternType = default
    extendedRegexp = false
    fullName = true
    fallbackToNoIndex = false

[color "advice"]
	hint = hint

[color "blame"]
	highlightRecent = 
	repeatedLines = dim

[color "branch"]
	color = auto
	current = green
	local = normal
	remote = red
	upstream = blue
	plain = normal

[color "diff"]
	color = auto
	context = normal
	meta = bold
	frag = cyan
	func = normal
	old = red
	new = green
	commit = yellow
	whitespace = red reverse
	oldMoved = bold cyan
	newMoved = bold yellow

[color "decorate"]
	headline = normal
	branch = green
	remoteBranch = red
	tag = bold yellow
	stash = bold magenta
	HEAD = bold cyan
	graft = bold magenta

[color "grep"]
	color = auto
	context = normal
	filename = normal
	function = normal
	lineNumber = normal
	match = bold red
	matchContext = bold red
	matchSelected = bold red
	selected = normal
	separator = normal

[color "interactive"]
	color = auto
	prompt = bold blue
	header = bold
	help = red
	error = bold red

[color]
	pager = true

[color "push"]
	color = auto
	error = red

[color "transport"]
	color = auto
	rejected = red

[color "remote"]
	color = auto
	hint = yellow
	warning = bold yellow
	error = bold red
	success = bold green

[color "showBranch"]
	color = auto

[color "status"]
	color = auto
	header = normal
	added = green
	updated = green
	changed = red
	untracked = red
	branch = bold cyan
	nobranch = bold red
	localBranch = bold green
	remoteBranch = red
	unmerged = bold red
