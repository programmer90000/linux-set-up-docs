# Enable popups and IPC modules
Set Popups = "True"
include("winops.widget")

bar {
    layer = "top"
    mirror = "*"
    exclusive_zone = "auto"

    # --- Left Side: Launchers ---
    grid {
        button {
            value = "view-grid-symbolic"
            action[LeftClick] = "nwggrid"
        }
        button {
            value = ""
            action[LeftClick] = "window-switcher"
        }
        button {
            value = "brave-browser"
            action[LeftClick] = "brave-browser --password-store=libsecret"
        }
        button {
            value = "thunderbird"
            action[LeftClick] = "thunderbird"
        }
        button {
            value = "alacritty"
            action[LeftClick] = "alacritty"
        }
    }

    # Taskbar in center
    taskbar {
        rows = 1
        icons = true
        labels = true
    }

    # --- Right Side (Right-to-Left order) ---
    layout ":end" {
        # 1. Date (Top) / Time (Bottom) with Calendar Popup
        button {
            label = Time("%b %d, %Y\n%I:%M %p")
            style = "datetime_widget"
            tooltip = "Click for Calendar"
            action = "sfwbar-calendar"
        }

        # 2. Caps Lock Indicator (Only visible when Caps Lock is active)
        label {
            value = CapLock() ? " CAPS " : ""
            style = "caps_lock"
        }

        # 3. Virtual Desktops / Workspaces
        pager {
            style = "workspace_pager"
            rows = 1
            pins = ["1","2","3","4"]
        }

        # 4. Notifications Toggle
        button {
            icon = "preferences-system-notifications"
            tooltip = "Notifications"
            action = "swaync-client -t -sw"
        }

        # 5. CopyQ Clipboard Manager
        button {
            icon = "copyq"
            tooltip = "Clipboard Manager"
            action = "copyq toggle"
        }

        # 6. Volume Control (Includes slider popup and dynamic mute/volume icons)
        include("volume.widget")

        # 7. Network / Wi-Fi Status (Includes popup network menu)
        include("network.widget")

        # 8. Power / Logout Options Menu Button
        button {
            icon = "system-shutdown"
            tooltip = "Power Menu"
            action = "wlogout"
        }
    }
}
