bar {
    layer = "top"
    mirror = "*"
    exclusive_zone = "auto"

    grid {
        button {
            value = "view-grid-symbolic"
            action[LeftClick] = "nwggrid"
        }
        button {
            value = "window-switcher.png"
            action[LeftClick] = "window-switcher"
        }
        button {
            value = "brave-browser"
            action[LeftClick] = "brave-browser --password-store=libsecret"
        }
        button {
            value = "thunderbird"
            action[LeftClick] = "thunderbird"
        }
        button {
            value = "alacritty"
            action[LeftClick] = "alacritty"
        }
    }

    # Empty label acts as a spacer to push items to the right
    label {
        value = ""
        css = "* { -GtkWidget-hexpand: true; }"
    }
    
    button {
        value = "audio-volume-high-symbolic"
        action = "PopUp('volume_popup')"
    }
    
    label {
        style = "clock"
        value = Time("%H:%M:%S\n%d-%m-%Y")
    }
}

PopUp "volume_popup" {
    grid {
        scale {
            value = Alsactl.Volume
            action = "Alsactl.Volume = $val"
        }
    }
}
