(defwindow bottom_bar :monitor 0 :geometry (geometry :x "0px" :y "0px" :width "100%" :height "40px" :anchor "bottom center") :stacking "fg" :exclusive true
    (box :class "main-container" :orientation "h" :space-evenly true
        (box :class "left-group" :halign "start" :space-evenly false
            (button :class "module switcher" :onclick "nwggrid &"
                (image :icon "view-grid-symbolic" :icon-size "menu")
            )
            (button :class "module window-switcher" :onclick "window-switcher &"
                (image :icon "preferences-system-windows" :icon-size "menu")
            )
        )
    )
)
